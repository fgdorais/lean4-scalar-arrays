    forIn7From lo hi j hlo init₁ init₂ init₃ init₄ init₅ init₆ init₇ body k =
      if hj : j < hi then
        body j hlo hj
          (fun b₁ b₂ b₃ b₄ b₅ b₆ b₇ =>
            forIn7From lo hi (j + 1) (forIn_le_succ hlo hj) b₁ b₂ b₃ b₄ b₅ b₆ b₇ body k)
