import all ScalarArray.UInt8.Program

/-!
# Loops with several variables on `UInt8Array`

The loops in continuation-passing style of `UInt8Array.InPlace.Tail` with 2 to 8 variables:
`Tail.forIn2`, … `Tail.forIn8`, and `Tail.forInRev2`, … `Tail.forInRev8` downward. Like
`Tail.forIn`, each variable is an argument of the loop, so scalars stay unboxed, and nested loops
allocate nothing. They wrap the loops of `ScalarArray.Loop`, and they are specified by their
one-step equations, `Tail.forIn2From_eq`, …

This module is generated by `scripts/generate.py`, from `scripts/loop_template.py`.
-/

namespace ScalarArray.UInt8Array.InPlace.Tail

variable {n : Nat} {γ : Type w}

/-! ## 2 variables -/

/-- `Tail.forIn2` from `j₀` instead of `lo`. It is specified by `Tail.forIn2From_eq`. -/
@[inline]
public def forIn2From {β₁ : Type v₁} {β₂ : Type v₂}
    (lo hi j₀ : USize) (h : lo.toNat ≤ j₀.toNat) (init₁ : β₁) (init₂ : β₂)
    (body : (j : USize) → lo.toNat ≤ j.toNat → j.toNat < hi.toNat →
      (β₁ → β₂ → Tail n γ) → β₁ → β₂ → Tail n γ)
    (k : β₁ → β₂ → Tail n γ) : Tail n γ :=
  ⟨Loop.forUp2 lo hi
    (fun j hlo hj next b₁ b₂ s =>
      (body j hlo hj (fun b₁ b₂ => ⟨next b₁ b₂⟩) b₁ b₂).fn s)
    (fun b₁ b₂ s => (k b₁ b₂).fn s) j₀ h init₁ init₂⟩

/-- `Tail.forIn` with 2 variables, which the loop keeps as 2 arguments. -/
@[inline, expose]
public def forIn2 {β₁ : Type v₁} {β₂ : Type v₂}
    (lo hi : USize) (init₁ : β₁) (init₂ : β₂)
    (body : (j : USize) → lo.toNat ≤ j.toNat → j.toNat < hi.toNat →
      (β₁ → β₂ → Tail n γ) → β₁ → β₂ → Tail n γ)
    (k : β₁ → β₂ → Tail n γ) : Tail n γ :=
  forIn2From lo hi lo (Nat.le_refl _) init₁ init₂ body k

