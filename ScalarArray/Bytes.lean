/-!
# Byte order

Conversions between the arrays with elements wider than a byte and `ByteArray`, in little-endian
(`LE`, least significant byte first) or big-endian (`BE`, most significant byte first) order, and
in-place byte swaps of the integer arrays. Floats are converted through their IEEE 754 bits.
`Slice.ofBytes…` reads the bytes of a `UInt8Array.Slice` instead, such as the part of a
`ByteArray` after a header, without copying the rest.

The results do not depend on the byte order of the machine. That byte order is computed once, when
the module is initialized: when a conversion asks for the machine's own order, it copies the whole
array at once. Otherwise `ofBytes…` copies and then swaps the bytes of each element in place, and
`toBytes…` is a loop of shifts and byte accesses, which the C compiler turns into whole-word loads,
stores and byte swap instructions.

**Experimental.** The names and types here may still change. `import ScalarArray` does not import
this module; use `import ScalarArray.Bytes`.

This module is generated by `scripts/generate.py`; edit `scripts/bytes_template.py` instead.
-/

/-- Reverses the order of the bytes of `x`. -/
@[inline, expose] public def UInt16.byteSwap (x : UInt16) : UInt16 :=
  (x >>> 8) ||| (x <<< 8)

/-- Reverses the order of the bytes of `x`. -/
-- Swaps neighboring bytes, then the two halves: fewer operations than moving each byte, in case
-- the C compiler doesn't recognize a byte swap.
@[inline, expose] public def UInt32.byteSwap (x : UInt32) : UInt32 :=
  let x := ((x &&& 0x00FF00FF) <<< 8) ||| ((x >>> 8) &&& 0x00FF00FF)
  (x >>> 16) ||| (x <<< 16)

/-- Reverses the order of the bytes of `x`. -/
-- Swaps neighboring bytes, then neighboring pairs of bytes, then the two halves.
@[inline, expose] public def UInt64.byteSwap (x : UInt64) : UInt64 :=
  let x := ((x &&& 0x00FF00FF00FF00FF) <<< 8) ||| ((x >>> 8) &&& 0x00FF00FF00FF00FF)
  let x := ((x &&& 0x0000FFFF0000FFFF) <<< 16) ||| ((x >>> 16) &&& 0x0000FFFF0000FFFF)
  (x >>> 32) ||| (x <<< 32)

/-- Reverses the order of the bytes of `x`. -/
@[inline, expose] public def Int16.byteSwap (x : Int16) : Int16 := x.toUInt16.byteSwap.toInt16

/-- Reverses the order of the bytes of `x`. -/
@[inline, expose] public def Int32.byteSwap (x : Int32) : Int32 := x.toUInt32.byteSwap.toInt32

/-- Reverses the order of the bytes of `x`. -/
@[inline, expose] public def Int64.byteSwap (x : Int64) : Int64 := x.toUInt64.byteSwap.toInt64

@[simp] public theorem UInt16.byteSwap_byteSwap (x : UInt16) : x.byteSwap.byteSwap = x := by
  simp only [UInt16.byteSwap]; bv_decide

@[simp] public theorem UInt32.byteSwap_byteSwap (x : UInt32) : x.byteSwap.byteSwap = x := by
  simp only [UInt32.byteSwap]; bv_decide

@[simp] public theorem UInt64.byteSwap_byteSwap (x : UInt64) : x.byteSwap.byteSwap = x := by
  simp only [UInt64.byteSwap]; bv_decide

@[simp] public theorem Int16.byteSwap_byteSwap (x : Int16) : x.byteSwap.byteSwap = x := by
  simp [Int16.byteSwap]

@[simp] public theorem Int32.byteSwap_byteSwap (x : Int32) : x.byteSwap.byteSwap = x := by
  simp [Int32.byteSwap]

@[simp] public theorem Int64.byteSwap_byteSwap (x : Int64) : x.byteSwap.byteSwap = x := by
  simp [Int64.byteSwap]

namespace ScalarArray

/--
Whether the machine stores the least significant byte of a word first: byte 0 of a `UInt16Array`
holding `1`. A closed term, so it is computed once, when the module is initialized. The conversions
check it to copy whole arrays when the byte order they want is the machine's.
-/
private unsafe def hostLittleEndian : Bool :=
  (unsafeCast (UInt16Array.mk #[1]) : ByteArray).get! 0 == 1

/-- The `len` bytes of `a` from byte `off`, copied into a new array of `elemSize`-byte elements. -/
private unsafe def copyBytes (elemSize : UInt32) (a : @& Raw) (off len : USize) : Raw :=
  let n := len / elemSize.toUSize
  (Raw.allocate elemSize n n lcProof).memmoveUnsafe a off 0 len

namespace UInt16Array

private def byteSwapImpl (a : UInt16Array) : UInt16Array :=
  a.toSlice.foldlInPlaceThen () (fun _ _ x _ => (x.byteSwap, ())) (fun s _ => s.array)

/-- Reverses the order of the bytes of each element, in place when `a` is not shared. -/
@[implemented_by byteSwapImpl, expose]
public def byteSwap (a : UInt16Array) : UInt16Array :=
  mk (a.toArray.map UInt16.byteSwap)

@[simp] public theorem toArray_byteSwap (a : UInt16Array) :
    a.byteSwap.toArray = a.toArray.map UInt16.byteSwap :=
  rfl

@[simp] public theorem size_byteSwap (a : UInt16Array) : a.byteSwap.size = a.size := by
  simp [← size_toArray]

@[simp] public theorem getElem_byteSwap (a : UInt16Array) (i : Nat) (h : i < a.byteSwap.size) :
    a.byteSwap[i] = (a[i]'(by simpa using h)).byteSwap := by
  rw [getElem_eq_getElem_toArray, getElem_eq_getElem_toArray]
  simp

@[simp] public theorem byteSwap_byteSwap (a : UInt16Array) : a.byteSwap.byteSwap = a := by
  apply ext_getElem <;> simp

private unsafe def Slice.toBytesLEImpl (s : UInt16Array.Slice) : ByteArray :=
  if hostLittleEndian then
    unsafeCast (copyBytes 1 (unsafeCast s.array) (2 * s.start.toUSize) (2 * s.size.toUSize))
  else
    -- Uninitialized: the loop stores every byte, so filling it first would be a wasted pass.
    let m := 2 * s.size.toUSize
    let r : UInt8Array := unsafeCast (Raw.allocate 1 m m lcProof)
    (loop s.array s.stop.toUSize r s.start.toUSize 0).toByteArray
where
  loop (a : UInt16Array) (stop : USize) (r : UInt8Array) (i j : USize) : UInt8Array :=
    if i < stop then
      let u := (a.uget i lcProof)
      -- `r` is a fresh array, so the stores need no exclusivity checks, and they combine into one
      -- word store.
      loop a stop (r
        |>.setUnsafe j u.toUInt8
        |>.setUnsafe (j + 1) (u >>> 8).toUInt8) (i + 1) (j + 2)
    else
      r

/-- The elements of `s` as bytes, each in little-endian order, least significant byte first. -/
@[implemented_by Slice.toBytesLEImpl, expose]
public def Slice.toBytesLE (s : UInt16Array.Slice) : ByteArray :=
  ⟨Array.ofFn (n := 2 * s.size) fun ⟨j, hj⟩ =>
    ((s[j / 2]'(by lia)) >>> (8 * (j % 2)).toUInt16).toUInt8⟩

/-- The elements of `a` as bytes, each in little-endian order, least significant byte first. -/
@[inline, expose]
public def toBytesLE (a : UInt16Array) : ByteArray := a.toSlice.toBytesLE

private unsafe def ofBytesLE?Impl (b : ByteArray) : Option UInt16Array :=
  if b.size % 2 = 0 then
    -- One copy, then, unless the byte order is the machine's, a byte swap in place.
    let r := copyBytes 2 (unsafeCast b) 0 b.usize
    if hostLittleEndian then
      some (unsafeCast r)
    else
      some (unsafeCast (UInt16Array.byteSwap (unsafeCast r)))
  else
    none

/--
Reads `b` as elements, each in little-endian order, least significant byte first.
Returns `none` if the size of `b` is not a multiple of 2.
-/
@[implemented_by ofBytesLE?Impl, expose]
public def ofBytesLE? (b : ByteArray) : Option UInt16Array :=
  if b.size % 2 = 0 then
    some <| ofFn (n := b.size / 2) fun ⟨i, hi⟩ =>
      (b[2 * i]'(by lia)).toUInt16 |||
        ((b[2 * i + 1]'(by lia)).toUInt16 <<< 8)
  else
    none

/--
Reads `b` as elements, each in little-endian order, least significant byte first.
Panics if the size of `b` is not a multiple of 2.
-/
public def ofBytesLE! (b : ByteArray) : UInt16Array :=
  match ofBytesLE? b with
  | some a => a
  | none => panic! "byte array size is not a multiple of 2"

private unsafe def Slice.ofBytesLE?Impl (s : UInt8Array.Slice) : Option UInt16Array :=
  if s.size % 2 = 0 then
    -- One copy, then, unless the byte order is the machine's, a byte swap in place.
    let r := copyBytes 2 (unsafeCast s.array) s.start.toUSize s.size.toUSize
    if hostLittleEndian then
      some (unsafeCast r)
    else
      some (unsafeCast (UInt16Array.byteSwap (unsafeCast r)))
  else
    none

/--
Reads the bytes of `s` as elements, each in little-endian order, least significant byte first.
Returns `none` if the size of `s` is not a multiple of 2.
-/
@[implemented_by Slice.ofBytesLE?Impl, expose]
public def Slice.ofBytesLE? (s : UInt8Array.Slice) : Option UInt16Array :=
