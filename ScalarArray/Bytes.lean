/--
Reads the bytes of `s` as elements, each in little-endian order, least significant byte first.
Panics if the size of `s` is not a multiple of 2.
-/
public def Slice.ofBytesLE! (s : UInt8Array.Slice) : UInt16Array :=
  match Slice.ofBytesLE? s with
  | some a => a
  | none => panic! "byte slice size is not a multiple of 2"

@[simp] public theorem Slice.ofBytesLE?_toUInt8Array (b : ByteArray) :
    Slice.ofBytesLE? b.toUInt8Array = UInt16Array.ofBytesLE? b := by
  unfold Slice.ofBytesLE? UInt16Array.ofBytesLE?
  by_cases h : b.size % 2 = 0
  · rw [ite_eq_left (by simpa using h), ite_eq_left h]
    congr 1
    apply ext_getElem
    · simp
    · intro i _ _
      simp [UInt8Array.Slice.getElem_eq]
  · rw [ite_eq_right (by simpa using h), ite_eq_right h]

@[simp] public theorem Slice.size_toBytesLE (s : UInt16Array.Slice) :
    s.toBytesLE.size = 2 * s.size := by
  simp [Slice.toBytesLE, ← ByteArray.size_data]

@[simp] public theorem size_toBytesLE (a : UInt16Array) : a.toBytesLE.size = 2 * a.size := by
  simp [toBytesLE]

@[simp] public theorem Slice.getElem_toBytesLE (s : UInt16Array.Slice) (j : Nat)
    (h : j < s.toBytesLE.size) :
    s.toBytesLE[j] =
      ((s[j / 2]'(by rw [Slice.size_toBytesLE] at h; lia)) >>> (8 * (j % 2)).toUInt16).toUInt8 := by
  simp only [Slice.toBytesLE, ByteArray.getElem_eq_getElem_data, Array.getElem_ofFn]

@[simp] public theorem ofBytesLE?_toBytesLE_slice (s : UInt16Array.Slice) :
    ofBytesLE? s.toBytesLE = some s.copy := by
  rw [ofBytesLE?, ite_eq_left_of_eq_true _ _ (by simp)]
  congr 1
  apply ext_getElem
  · simp
  · intro i _ h
    have hi : i < s.size := by simpa using h
    simp only [getElem_ofFn, Slice.getElem_toBytesLE, Slice.getElem_copy,
      show (2 * i) / 2 = i by lia, show (2 * i) % 2 = 0 by lia,
      show (2 * i + 1) / 2 = i by lia, show (2 * i + 1) % 2 = 1 by lia]
    simp only [Nat.reduceMul, Nat.toUInt16,
      UInt16.reduceOfNat]
    generalize s[i] = x
    bv_decide

@[simp] public theorem ofBytesLE?_toBytesLE (a : UInt16Array) :
    ofBytesLE? a.toBytesLE = some a := by
  simp [toBytesLE]

private unsafe def Slice.toBytesBEImpl (s : UInt16Array.Slice) : ByteArray :=
  if !hostLittleEndian then
    unsafeCast (copyBytes 1 (unsafeCast s.array) (2 * s.start.toUSize) (2 * s.size.toUSize))
  else
    -- Uninitialized: the loop stores every byte, so filling it first would be a wasted pass.
    let m := 2 * s.size.toUSize
    let r : UInt8Array := unsafeCast (Raw.allocate 1 m m lcProof)
    (loop s.array s.stop.toUSize r s.start.toUSize 0).toByteArray
where
  loop (a : UInt16Array) (stop : USize) (r : UInt8Array) (i j : USize) : UInt8Array :=
    if i < stop then
      let u := (a.uget i lcProof)
      -- `r` is a fresh array, so the stores need no exclusivity checks, and they combine into one
      -- word store.
      loop a stop (r
        |>.setUnsafe j (u >>> 8).toUInt8
        |>.setUnsafe (j + 1) u.toUInt8) (i + 1) (j + 2)
    else
      r

/-- The elements of `s` as bytes, each in big-endian order, most significant byte first. -/
