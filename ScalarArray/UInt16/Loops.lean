/-- One step of `Tail.forIn5From`. -/
public theorem forIn5From_eq {β₁ : Type v₁} {β₂ : Type v₂} {β₃ : Type v₃} {β₄ : Type v₄}
    {β₅ : Type v₅}
    (lo hi j : USize) (hlo : lo.toNat ≤ j.toNat) (init₁ : β₁) (init₂ : β₂) (init₃ : β₃) (init₄ : β₄)
    (init₅ : β₅)
    (body : (j : USize) → lo.toNat ≤ j.toNat → j.toNat < hi.toNat →
      (β₁ → β₂ → β₃ → β₄ → β₅ → Tail n γ) → β₁ → β₂ → β₃ → β₄ → β₅ → Tail n γ)
    (k : β₁ → β₂ → β₃ → β₄ → β₅ → Tail n γ) :
    forIn5From lo hi j hlo init₁ init₂ init₃ init₄ init₅ body k =
      if hj : j < hi then
        body j hlo hj
          (fun b₁ b₂ b₃ b₄ b₅ =>
            forIn5From lo hi (j + 1) (forIn_le_succ hlo hj) b₁ b₂ b₃ b₄ b₅ body k)
          init₁ init₂ init₃ init₄ init₅
      else k init₁ init₂ init₃ init₄ init₅ := by
  apply fn_inj; funext s
  show Loop.forUp5 lo hi _ _ j hlo init₁ init₂ init₃ init₄ init₅ s = _
  rw [Loop.forUp5_eq]
  by_cases hj : j < hi
  · simp only [hj, ↓reduceDIte]; rfl
  · simp only [hj, ↓reduceDIte]

