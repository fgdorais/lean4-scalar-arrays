/-!
# Loops with many variables on `UInt16Array`

The loops in continuation-passing style of `UInt16Array.InPlace.Tail` with 5 to 8 variables,
`Tail.forIn5`, … `Tail.forIn8` and `Tail.forInRev5`, … `Tail.forInRev8`, like `Tail.forIn4`: each
variable is an argument of the loop, so scalars stay unboxed, and nested loops allocate nothing.
They are specified by their one-step equations, `Tail.forIn5From_eq`, …

This module is generated by `scripts/generate.py`, from `scripts/loop_template.py`.
-/

namespace ScalarArray.UInt16Array.InPlace.Tail

variable {n : Nat} {γ : Type w}

/-! ## 5 variables -/

/-- `Tail.forIn5` from `j₀` instead of `lo`. It is specified by `Tail.forIn5From_eq`. -/
@[inline]
public def forIn5From {β₁ : Type v₁} {β₂ : Type v₂} {β₃ : Type v₃} {β₄ : Type v₄} {β₅ : Type v₅}
    (lo hi j₀ : USize) (h : lo.toNat ≤ j₀.toNat) (init₁ : β₁) (init₂ : β₂) (init₃ : β₃) (init₄ : β₄)
    (init₅ : β₅)
    (body : (j : USize) → lo.toNat ≤ j.toNat → j.toNat < hi.toNat →
      (β₁ → β₂ → β₃ → β₄ → β₅ → Tail n γ) → β₁ → β₂ → β₃ → β₄ → β₅ → Tail n γ)
    (k : β₁ → β₂ → β₃ → β₄ → β₅ → Tail n γ) : Tail n γ :=
  ⟨Loop.forUp5 lo hi
    (fun j hlo hj next b₁ b₂ b₃ b₄ b₅ s =>
      (body j hlo hj (fun b₁ b₂ b₃ b₄ b₅ => ⟨next b₁ b₂ b₃ b₄ b₅⟩) b₁ b₂ b₃ b₄ b₅).fn s)
    (fun b₁ b₂ b₃ b₄ b₅ s => (k b₁ b₂ b₃ b₄ b₅).fn s) j₀ h init₁ init₂ init₃ init₄ init₅⟩

/-- `Tail.forIn` with 5 variables, which the loop keeps as 5 arguments. -/
