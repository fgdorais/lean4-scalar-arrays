#guard Int64Array.Slice.ofBytesBE? Int64BytesBE.toUInt8Array[1...1] == some Int64Array.empty
#guard
  Int64Array.Slice.ofBytesBE! Int64BytesBE.toUInt8Array[8...*] ==
    Int64Array.mk #[-2]
#guard
  let a := Int64Array.ofFn (n := 1000) fun i => ((i.val * 2654435761).toUInt64).toInt64
  Int64Array.ofBytesBE! a.toBytesBE == a

#guard
  Int64Pair.toBytesLE.data.reverse ==
    (Int64Array.mk #[-2, 0x0102030405060708]).toBytesBE.data

#guard
  Int64Pair.byteSwap == Int64Array.mk #[(0x0102030405060708 : Int64).byteSwap,
    (-2 : Int64).byteSwap]
#guard Int64Pair.byteSwap.toBytesLE == Int64BytesBE

@[noinline] def Int64ByteSwapInPlace (x : Int64) : Bool :=
  let a := Int64Array.mk #[x, 2]
  let p := rawAddr a
  rawAddr a.byteSwap == p

#guard Int64ByteSwapInPlace 1

example (a : Int64Array) : Int64Array.ofBytesLE? a.toBytesLE = some a := by simp
example (a : Int64Array) : Int64Array.ofBytesBE? a.toBytesBE = some a := by simp
example (a : Int64Array) : a.byteSwap.byteSwap = a := by simp

